# The Foot Health Network Environment Variables Template

# Copy this file to '.env' and fill in your actual credentials.


# 1. Gemini API Key (for the Virtual Consultant chat widget)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Mailchimp CRM configuration
# Go to Mailchimp -> Signup forms -> Embedded forms.
# Find the form action URL (e.g. https://domain.us21.list-manage.com/subscribe/post?u=xxxx&id=yyyy)
# Replace /post with /post-json for JSONP/AJAX submission
VITE_MAILCHIMP_SUBSCRIBE_URL=https://your-domain.usxx.list-manage.com/subscribe/post-json?u=your_u_value&id=your_id_value

# 3. Email forwarding service (e.g. Web3Forms or Formspree)
# If using Web3Forms (recommended, free, no-backend):
# Get your free access key at https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Alternatively, specify a custom form submission endpoint (like Formspree or custom hook)
# If set, form data will be POSTed here instead of Web3Forms
VITE_EMAIL_FORM_URL=
